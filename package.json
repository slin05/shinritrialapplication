{
  "name": "shinri-notes",
  "productName": "Shinri Trial Notes",
  "version": "1.1.0",
  "description": "Always-on-top investigation notes overlay for Shinri Trial (Garry's Mod).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "press.shinri.notes",
    "productName": "Shinri Trial Notes",
    "files": ["main.js", "preload.js", "app/**/*"],
    "directories": { "output": "dist" },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "ShinriTrialNotes-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "ShinriTrialNotes-Portable-${version}.${ext}"
    }
  }
}
